{
  "manifest_version": 3,
  "name": "WebShift",
  "version": "0.1.0",
  "description": "Understand and transform the web.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}